/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.6;fontFamily=Cambria;fontColor=#000000;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="404" y="54" width="180" height="238.24" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Database&lt;br&gt;(Supabase)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;Stores towers,&lt;br&gt;locations, scan&lt;br&gt;missions, and results&lt;br&gt;&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.6;fontFamily=Cambria;fontColor=#000000;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="736" y="54" width="180" height="238.24" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;Drone&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;Flight controller:&lt;br&gt;SpeedyBee F405 Mini&lt;br&gt;(ArduPilot) +&lt;br&gt;GPS/compass&lt;br&gt;&lt;hr style=&quot;border:none;border-top:1px solid #7F7F7F;margin:3px 18px;&quot;&gt;Raspberry Pi Zero 2 W&lt;br&gt;+ Pi Camera V2:&lt;br&gt;records backup,&lt;br&gt;streams video, visual&lt;br&gt;alignment (QR +&lt;br&gt;ArUco)&lt;br&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.6;fontFamily=Cambria;fontColor=#000000;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="28" y="483.76" width="180" height="335.72" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;Ground Laptop&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;Live YOLOv8&lt;br&gt;detection (tower&lt;br&gt;frame, lettuce, empty&lt;br&gt;pot)&lt;br&gt;↓&lt;br&gt;Slot matching by face,&lt;br&gt;level, position&lt;br&gt;↓&lt;br&gt;Slot availability&lt;br&gt;&lt;hr style=&quot;border:none;border-top:1px solid #7F7F7F;margin:3px 18px;&quot;&gt;Local offline cache&lt;br&gt;Local dashboard: start&lt;br&gt;scan, Live Scan, Sync&lt;br&gt;Center&lt;br&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.6;fontFamily=Cambria;fontColor=#000000;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="404" y="483.76" width="180" height="335.72" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;Web Dashboard&lt;br&gt;(Next.js)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;Tower map, per-pot&lt;br&gt;results, scan history&lt;br&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.6;fontFamily=Cambria;fontColor=#000000;fontSize=19;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="736" y="483.76" width="180" height="335.72" as="geometry"/></mxCell><mxCell id="c5" value="1a" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Cambria;spacing=0;" vertex="1" parent="1"><mxGeometry x="291.33" y="135.92" width="29.34" height="22.4" as="geometry"/></mxCell><mxCell id="c6" value="1b" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Cambria;spacing=0;" vertex="1" parent="1"><mxGeometry x="291" y="187.92" width="30" height="22.4" as="geometry"/></mxCell><mxCell id="c7" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Cambria;spacing=0;" vertex="1" parent="1"><mxGeometry x="648.8" y="135.92" width="22.4" height="22.4" as="geometry"/></mxCell><mxCell id="c8" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Cambria;spacing=0;" vertex="1" parent="1"><mxGeometry x="294.8" y="492.56" width="22.4" height="22.4" as="geometry"/></mxCell><mxCell id="c9" v